# ─────────────────────────────────────────────────────────────────────────────
# RJNX ADMIN — environment configuration (TEMPLATE ONLY)
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the API (and, in production, the built admin UI) listens on
PORT=4001
# development | production
NODE_ENV=development
# Public base URL of this server. Used to build absolute media URLs that the
# public websites consume, and for password-reset links.
BASE_URL=http://localhost:4001
# Set to true when running behind a reverse proxy (nginx, Railway, Render…)
TRUST_PROXY=false

# ── Security ─────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Force Secure cookies (recommended when serving over HTTPS in production)
COOKIE_SECURE=false

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database file path (relative to the server/ directory, or absolute)
DATABASE_PATH=./data/rjnx.db
# Where uploaded/optimized media files are stored (default: server/uploads/).
# Set to an absolute path when a cloud volume is mounted elsewhere (see DEPLOY.md).
# UPLOADS_DIR=/app/server/uploads
# Apply pending migrations automatically when the server boots
AUTO_MIGRATE=true

# ── Bootstrap admin (used by `npm run db:seed` / first server boot) ──────────
ADMIN_NAME=RJNX Admin
ADMIN_EMAIL=admin@rjnx.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Uploads ──────────────────────────────────────────────────────────────────
# Maximum upload size per image, in megabytes (images are auto-optimized)
MAX_UPLOAD_MB=8

# ── Public API (consumed by the two public websites) ─────────────────────────
# Comma-separated list of allowed origins for public endpoints,
# or * to allow any origin. Admin endpoints are same-origin only.
PUBLIC_API_ORIGINS=*

# ── Email / SMTP (optional — password reset delivery) ────────────────────────
# When MAIL_TRANSPORT=console (default) reset links are printed to the server
# log instead of being emailed, so no credentials are required to run locally.
# To actually send mail, set MAIL_TRANSPORT=smtp and fill in the SMTP block.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RJNX Admin <no-reply@example.com>"
